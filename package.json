{
  "name": "shree-agent-cli",
  "version": "1.0.0",
  "description": "this is cli tool to use ollama model, features: create, testing, deploy to developer code as per json step's and develope localy.",
  "type": "commonjs",
  "bin": {
    "taskAgent": "./bin/taskAgent.js"
  },
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node bin/taskAgent.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.js",
    "release": "semantic-release",
    "version": "standard-version",
    "prepare": "husky install",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.7",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "@types/commander": "^2.12.0",
    "@types/inquirer": "^9.0.8",
    "@types/jest": "^30.0.0",
    "@types/node-fetch": "^2.6.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "@typescript-eslint/parser": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "husky": "^8.0.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "semantic-release": "^23.0.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbysingh2005/shree-agent-cli.git"
  },
  "keywords": [
    "ai",
    "ollama",
    "own",
    "smart",
    "developer",
    "shree",
    "agent",
    "cli",
    "project-generator",
    "chat",
    "typescript"
  ],
  "author": "bobby singh<bobbysingh2005@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bobbysingh2005/shree-agent-cli/issues"
  },
  "homepage": "https://github.com/bobbysingh2005/shree-agent-cli#readme",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
